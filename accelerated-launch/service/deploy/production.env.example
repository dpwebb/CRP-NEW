# CRP local consumer-journey service — production environment template.
#
# ⛔ KEY NAMES AND FIXED VALUES ONLY. This file is COMMITTED. A secret placed here has been published.
#    The real values are supplied by the operator on the host, in a file this repository cannot see.
#    (The read-only legacy checkout states the same rule in its own `deploy/env/.env.staging.example`:
#     "KEY NAMES ONLY IN THIS REPOSITORY".)
#
# NOTHING IN THIS FILE HAS BEEN APPLIED. No host was contacted, no service was installed and no provider was
# provisioned by the batch that created it. `release-check.cjs` asserts this file carries no value for any
# secret name and does not name the test payment adapter.

# ── Bind address ─────────────────────────────────────────────────────────────────────────────────────
# The service binds LOOPBACK ONLY by default and refuses nothing else; a public origin must terminate TLS in
# front of it and forward to 127.0.0.1. Setting a public bind here would expose consumer reports directly.
CRP_LOCAL_SERVICE_HOST=127.0.0.1
CRP_LOCAL_SERVICE_PORT=8787
# Mark the session cookie Secure when, and only when, TLS is terminated in front of the service.
CRP_LOCAL_SERVICE_SECURE_COOKIE=

# ── Private state ────────────────────────────────────────────────────────────────────────────────────
# ABSOLUTE path to the private data directory. The service REFUSES TO START if it resolves inside the
# repository, because report bytes must never be written into a tree that is copied or published.
# One writer per directory: a second process is refused, and a lock left by a dead process is taken over.
CRP_LOCAL_SERVICE_DATA=
# 'silent' suppresses the log sink entirely. Unset, sanitized one-line JSON records go to stderr.
CRP_LOCAL_SERVICE_LOG=

# ── Payment provider ─────────────────────────────────────────────────────────────────────────────────
# REQUIRED FOR BILLING, AND NOT SUPPLIED. The provider this build declares is Stripe: one CAD Price per plan
# (see `plan-catalog.cjs`) and one webhook endpoint whose signing secret is set below. Provider selection and
# access are NOT authorized, so `payment-provider.cjs` ships the interface and a declared-but-unimplemented
# Stripe shape and makes no outbound call. Until these are supplied, every checkout is refused with
# PAYMENT_PROVIDER_NOT_CONFIGURED and NO ENTITLEMENT CAN BE ACTIVATED.
CRP_PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# One CAD Price ID per plan (see plan-catalog.cjs): report_once 595 one-time, monthly 795/month, annual 7950/year.
STRIPE_PRICE_REPORT_ONCE=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# A once-duration CAD 595 coupon that discounts only the FIRST subscription invoice (the upgrade credit).
STRIPE_UPGRADE_CREDIT_COUPON=
# Comma-separated allowed return origins for Checkout success/cancel URLs. Anything else is refused.
STRIPE_APP_ORIGINS=

# ── Support reference ────────────────────────────────────────────────────────────────────────────────
# REQUIRED FOR PRODUCTION REFERENCE STABILITY, AND NOT SUPPLIED. The account-owned diagnostic reference
# (BLOCKER-SUPPORT-001) is HMAC-derived from this secret. Configure a stable secret so references survive
# restarts; without one the service generates an ephemeral per-process secret and references change on
# restart. The secret is never printed, logged or returned to any caller.
CRP_SUPPORT_REFERENCE_SECRET=

# ── Local OCR (United States consumer disclosure) ────────────────────────────────────────────────────
# The United States section needs a LOCAL OCR engine. Absent, that one section reports SKIPPED with an exact
# reason and never falls back to a network service. Nothing is downloaded or installed by this build.
CRP_TESSERACT_EXE=
CRP_TESSDATA_DIR=

# ── Read-only legacy checkout (tests only) ──────────────────────────────────────────────────────────
# Where `h-legacy-parity.cjs` and `t-entitlement.cjs` READ the legacy upload gate, ownership middleware and
# price catalog. Never imported, never built, never written to.
CRP_LEGACY_CHECKOUT=
