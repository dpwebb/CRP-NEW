+@font-face { font-family: 'CRP Roboto'; src: url('Roboto-Bold.ttf') format('truetype'); font-weight: 700; font-display: swap; }
+@font-face { font-family: 'CRP Open Sans'; src: url('OpenSans-Regular.ttf') format('truetype'); font-weight: 400; font-display: swap; }
+@font-face { font-family: 'CRP Open Sans'; src: url('OpenSans-Bold.ttf') format('truetype'); font-weight: 700; font-display: swap; }
+/* Public and signed-out surfaces only. Authenticated workspace styles stay in style.css. */
+body.story-page, body.auth-entry { margin:0; background:#FAFAF3; color:#17362F; font-family:'CRP Open Sans',Arial,sans-serif; }
+.story-page *, .auth-entry * { box-sizing:border-box; }
+.story-page a, .auth-entry a { color:inherit; }
+.story-page h1, .story-page h2, .story-page h3, .auth-entry h1, .auth-entry h2, .story-brand { font-family:'CRP Roboto',Arial,sans-serif; font-weight:700; }
+.story-container { width:calc(100% - 128px); max-width:1312px; margin:auto; }
+.story-skip { position:fixed; top:8px; left:8px; padding:12px; background:white; z-index:20; transform:translateY(-150%); }
+.story-skip:focus { transform:none; }
+.story-page :focus-visible, .auth-entry :focus-visible { outline:3px solid #657B58; outline-offset:4px; }
+.story-brand { display:inline-flex; align-items:center; min-height:44px; gap:13px; font-size:27px; text-decoration:none; white-space:nowrap; }
+.story-mark { width:38px; height:38px; border-radius:11px; display:inline-flex; align-items:center; justify-content:center; background:#17362F; color:#D4E887; font:700 29px 'CRP Roboto',Arial,sans-serif; flex-shrink:0; }
+.story-header { display:flex; justify-content:space-between; align-items:center; padding:29px 0 22px; gap:24px; border-bottom:1px solid #D6DFD2; }
+.story-desktop-nav { display:flex; align-items:center; gap:36px; font-size:15px; font-weight:700; }
+.story-desktop-nav a { min-height:44px; display:inline-flex; align-items:center; text-decoration:none; }
+.story-desktop-nav a:last-child { border:1px solid #657B58; border-radius:9px; padding:0 20px; }
+.story-mobile-menu { display:none; position:relative; }
+.story-mobile-menu summary { cursor:pointer; width:44px; height:44px; display:flex; align-items:center; justify-content:center; list-style:none; }
+.story-mobile-menu summary::-webkit-details-marker { display:none; }
+.story-mobile-menu svg { width:24px; height:24px; }
+.story-mobile-menu nav { position:absolute; right:0; top:48px; background:white; border:1px solid #D6DFD2; border-radius:10px; padding:12px; width:220px; z-index:10; box-shadow:0 8px 25px #17362F15; }
+.story-mobile-menu nav a { display:flex; align-items:center; min-height:44px; padding:0 10px; text-decoration:none; }
+.story-hero { display:grid; grid-template-columns:1.2fr 1fr; gap:48px; padding:78px 0 76px; border-bottom:1px solid #D6DFD2; }
+.story-eyebrow { color:#17362F; font-size:12px; font-weight:700; letter-spacing:2px; text-transform:uppercase; margin:0 0 28px; }
+.story-eyebrow svg { width:20px; height:20px; vertical-align:middle; margin-right:10px; }
+.story-page h1 { font-size:78px; line-height:1.2; letter-spacing:-.8px; margin:0; }
+.story-page h1 em { display:block; color:#657B58; font-style:normal; max-width:420px; margin-top:15px; }
+.story-lead { font-size:21px; line-height:1.62; color:#52675B; margin:34px 0 0; max-width:660px; }
+.story-actions { display:flex; align-items:center; gap:36px; margin-top:98px; }
+.story-button { min-height:60px; padding:16px 24px; background:#17362F; color:white!important; border:1px solid #17362F; border-radius:9px; display:inline-flex; align-items:center; justify-content:space-between; gap:28px; font-size:17px; font-weight:700; text-decoration:none; }
+.story-button span { color:#D4E887; font-size:27px; line-height:1; }
+.story-text-link { display:inline-flex; align-items:center; min-height:44px; font-size:17px; font-weight:700; text-underline-offset:5px; }
+.story-supporting { margin:30px 0 0; color:#52675B; font-size:15px; line-height:1.6; }
+.story-supporting + .story-supporting { margin-top:10px; font-size:14px; }
+.story-art { position:relative; width:100%; max-width:525px; aspect-ratio:525/700; align-self:center; margin:100px 0 0; }
+.story-art > svg { position:absolute; width:100%; height:82%; top:2%; }
+.story-report { position:absolute; left:13%; top:12%; width:75%; height:65%; background:white; padding:30px; border:1px solid #D6DFD2; border-radius:14px; transform:rotate(-5deg); box-shadow:10px 16px 0 #D5DEC9; }
+.story-report-heading { display:flex; justify-content:space-between; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; }
+.story-report > p { font-size:12px; color:#52675B; }
+.story-report-line { height:7px; background:#EAF0DD; border-radius:3px; margin:15px 0; }
+.story-report-line:nth-of-type(3) { width:70%; }
+.story-sample-account { background:#F5F7EE; border:1px solid #D6DFD2; border-radius:8px; padding:15px; }
+.story-sample-account h3 { font-size:16px; margin:0 0 15px; }
+.story-sample-account dl { margin:0; font-size:14px; }
+.story-sample-account dl > div { display:flex; justify-content:space-between; gap:8px; margin-top:12px; }
+.story-sample-account dd { margin:0; text-align:right; font-weight:700; }
+.story-insight { position:absolute; left:3%; top:70%; width:84%; padding:23px 24px 30px 43px; background:white; border:1px solid #D6DFD2; border-radius:12px; box-shadow:0 9px 20px #17362F08; }
+.story-insight::before { content:''; position:absolute; top:23px; left:20px; width:7px; height:84px; border-radius:4px; background:#D4E887; }
+.story-insight .story-eyebrow { font-size:10px; margin-bottom:12px; }
+.story-page .story-insight h2 { font-size:23px; margin:0 0 10px; }
+.story-insight p:last-child { font-size:15px; line-height:1.6; color:#52675B; margin:0; }
+.story-art figcaption { position:absolute; bottom:0; width:100%; text-align:center; font-size:16px; color:#52675B; }
+.story-how { padding:58px 0 0; }
+.story-page h2 { font-size:38px; line-height:1.25; margin:0 0 40px; letter-spacing:-.3px; }
+.story-how h2 span { color:#657B58; }
+.story-journey { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:36px; padding:0; margin:0; list-style:none; }
+.story-journey li { background:white; border:1px solid #D6DFD2; border-radius:12px; padding:20px; min-height:160px; }
+.story-journey .story-step-number { font-size:12px; color:#52675B; }
+.story-journey h3 { font-size:21px; margin:20px 0 8px; }
+.story-journey p { color:#52675B; font-size:15px; line-height:1.65; margin:0; }
+.story-options { padding:72px 0 66px; }
+.story-options-intro { color:#52675B; font-size:18px; line-height:1.65; margin:-20px 0 36px; }
+.story-option-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:48px; }
+.story-option { border:1px solid #D6DFD2; border-radius:15px; padding:30px 32px 37px; background:white; }
+.story-option.subscription { background:#EAF0DD; }
